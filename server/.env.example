# Copy this file to server/.env and fill in the values. server/.env is git-ignored.
# Relative paths are resolved from the server/ folder.

# ---- Secrets ----
# Required in production (server refuses to start without it). 32+ random characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Password for the demo accounts in config/users.json. Logins are disabled until set.
DEMO_PASSWORD=

# ---- Server ----
PORT=4000
# Browser origins allowed to call the API (comma-separated)
CLIENT_ORIGINS=http://localhost:5173
# Session lifetime in hours (JWT expiry and cookie lifetime)
SESSION_TTL_HOURS=8
# true only when deployed behind a reverse proxy / load balancer
TRUST_PROXY=false
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_LOGIN_PER_15_MIN=10

# ---- Business rules ----
# Assumed USD price per Snowflake credit (same as PI_CORE.COST_ASSUMPTIONS)
USD_PER_CREDIT=3
# Load-latency alert tiers in seconds (brief: alert above 15s). Must be WARNING < HIGH < CRITICAL.
LATENCY_WARNING_SEC=15
LATENCY_HIGH_SEC=30
LATENCY_CRITICAL_SEC=50

# ---- Paths ----
RAW_DATA_FILE=../data/raw/pure_insights_monitoring.csv
DATA_DIR=../data/processed
DOCS_DIR=../docs
USERS_FILE=./config/users.json